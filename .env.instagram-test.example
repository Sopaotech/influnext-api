# Copy to .env.instagram-test and replace every placeholder with test-only values.
# This file contains placeholders only. Never reuse production credentials.
NODE_ENV=production
POSTGRES_USER=influnext_app
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
POSTGRES_DB=influnext_instagram_test
DATABASE_URL=postgresql://influnext_app:REPLACE_WITH_LOCAL_ONLY_PASSWORD@postgres:5432/influnext_instagram_test?schema=public
DIRECT_URL=postgresql://influnext_app:REPLACE_WITH_LOCAL_ONLY_PASSWORD@postgres:5432/influnext_instagram_test?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=REPLACE_WITH_RANDOM_LOCAL_TEST_SECRET
FRONTEND_URL=https://replace-with-meta-approved-test-host.invalid
ALLOWED_ORIGINS=https://replace-with-meta-approved-test-host.invalid
NEXT_PUBLIC_API_URL=https://replace-with-meta-approved-test-host.invalid/v1
NEXT_PUBLIC_ISOLATED_TEST=true
INFLUNEXT_TEST_API_ORIGIN=http://127.0.0.1:4000
INSTAGRAM_CLIENT_ID=REPLACE_WITH_META_APP_ID
INSTAGRAM_CLIENT_SECRET=REPLACE_WITH_META_APP_SECRET
INSTAGRAM_POST_SYNC_AI_ENABLED=false
SOCIAL_TOKEN_ACTIVE_KEY_ID=V1
SOCIAL_TOKEN_KEY_V1=REPLACE_WITH_64_HEX_TEST_ONLY_KEY
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_TEST_ONLY_KEY
